#!/usr/bin/env python3
import os
import re
import struct
import subprocess
import sys
import tempfile
import uuid


CDHASH_RE = re.compile(r"^CDHash=([0-9a-fA-F]{40})$", re.MULTILINE)


def run(command):
    return subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)


def archs_for(path):
    result = run(["xcrun", "lipo", "-archs", path])
    if result.returncode != 0:
        return []
    return result.stdout.split()


def cdhash_for(path):
    result = run(["codesign", "-d", "-vvvv", path])
    match = CDHASH_RE.search(result.stdout)
    if not match:
        return None
    return bytes.fromhex(match.group(1))


def cdhashes_for(path):
    archs = archs_for(path)
    if not archs:
        return []
    if len(archs) == 1:
        cdhash = cdhash_for(path)
        return [cdhash] if cdhash else []

    hashes = []
    with tempfile.TemporaryDirectory() as tmpdir:
        for arch in archs:
            thin_path = os.path.join(tmpdir, arch)
            result = run(["xcrun", "lipo", path, "-thin", arch, "-output", thin_path])
            if result.returncode != 0:
                continue
            cdhash = cdhash_for(thin_path)
            if cdhash:
                hashes.append(cdhash)
    return hashes


def collect_cdhashes(directory):
    hashes = set()
    for root, dirs, files in os.walk(directory):
        dirs[:] = [name for name in dirs if name != ".DS_Store"]
        for name in files:
            if name == ".DS_Store":
                continue
            path = os.path.join(root, name)
            if not os.path.isfile(path):
                continue
            for cdhash in cdhashes_for(path):
                print(f"Collecting cdhash of {path}")
                hashes.add(cdhash)
    return sorted(hashes)


def create(output_path, directory):
    hashes = collect_cdhashes(directory)
    with open(output_path, "wb") as output:
        output.write(struct.pack("<I", 1))
        output.write(uuid.uuid4().bytes)
        output.write(struct.pack("<I", len(hashes)))
        for cdhash in hashes:
            output.write(cdhash)
            output.write(bytes([2, 0]))
    print(f"Created {output_path} with {len(hashes)} cdhashes")


def main():
    if len(sys.argv) != 4 or sys.argv[1] != "create":
        print("usage: trustcache create <output.tc> <directory>", file=sys.stderr)
        return 2
    create(sys.argv[2], sys.argv[3])
    return 0


if __name__ == "__main__":
    sys.exit(main())
